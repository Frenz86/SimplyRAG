# .env.example — copia in .env e compila con i tuoi valori
# .env
POSTGRES_PASSWORD=password
WEBUI_SECRET_KEY=genera-una-chiave-random-es-hex-di-64-caratteri   # es: python -c "import secrets;print(secrets.token_hex(32))"
OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxx  # opzionale: solo se i modelli HuggingFace richiedono auth
PGADMIN_EMAIL=admin@esempio.com
PGADMIN_PASSWORD=cambia-questa-password

# Knowledge base filesystem tool (v0.9.6+): abilita comandi ls/cat/grep/find nelle KB per i modelli AI
# ENABLE_KB_EXEC=true  # già impostato nel docker-compose; decommenta qui solo per override

# Credenziali per gli script di import PDF (import-pdfs-*.py, cleanup-collections.py, utils/filter-models.py)
OWUI_EMAIL=admin@esempio.com
OWUI_PASSWORD=cambia-questa-password
# OWUI_BASE=http://localhost  # opzionale, default http://localhost

